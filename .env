# =====================================================================
# SPARTANZ 3.0 — Environment variables (FAKE / PLACEHOLDER VALUES)
# ---------------------------------------------------------------------
# These are placeholders so the app runs on the built-in mock backend.
# When you are ready, replace them with your real Supabase project values
# and set NEXT_PUBLIC_USE_SUPABASE=true to switch the data layer over.
# =====================================================================

# Toggle backend: "false" = built-in mock store, "true" = Supabase
NEXT_PUBLIC_USE_SUPABASE=false

# --- Supabase (fill these in later) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=fake-anon-key-replace-me
# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=fake-service-role-key-replace-me

# --- Google OAuth (configured inside Supabase Auth later) ---
GOOGLE_CLIENT_ID=fake-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=fake-google-client-secret

# --- App config ---
# The Google account that becomes the initial admin on first sign-in.
INITIAL_ADMIN_EMAIL=admin@rootsec.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000
