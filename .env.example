# ---------------------------------------------------------------------------
# SPARTANZ 3.0 — environment template
#
# Copy this file to `.env.local` and fill in the values. With NONE of these set
# the app runs in LOCAL/DEMO mode (JSON file store) and the admin panel still
# works. Fill in the Supabase keys to switch to the real database + Google auth.
# ---------------------------------------------------------------------------

# --- Supabase (leave blank to stay in local/demo mode) ---------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-only — NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL --------------------------------------------------------------
# Canonical public URL, used for OAuth redirects. Optional on Vercel
# (falls back to VERCEL_URL). Example: https://spartanz.example.com
NEXT_PUBLIC_SITE_URL=

# --- Admin bootstrap -------------------------------------------------------
# Email that is automatically granted the admin role on first sign-in.
INITIAL_ADMIN_EMAIL=
