# ============================================================
# SPARTANZ 3.0 — environment template
# Copy this file to `.env.local` and replace every REPLACE_ME value.
# `.env.local` is git-ignored. Never commit real keys.
# ============================================================

# ---------- Supabase (Project Settings > API) ----------
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME_https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_supabase_anon_public_key

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_supabase_service_role_key

# ---------- Initial admin ----------
# The first Google account that signs in with this email is promoted to admin.
INITIAL_ADMIN_EMAIL=REPLACE_ME_admin@example.com

# ---------- Site ----------
# Used to build OAuth redirect URLs and absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase Storage ----------
# Public bucket used for event images/GIFs and team member photos.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=spartanz-media

# ============================================================
# Supabase dashboard setup checklist
# ------------------------------------------------------------
# 1. Authentication > Providers > Google: enable, paste Google OAuth
#    client ID + secret from Google Cloud Console.
# 2. Google Cloud Console > Authorized redirect URI:
#      https://<your-project-ref>.supabase.co/auth/v1/callback
# 3. Authentication > URL Configuration > Site URL: your deployed URL.
#    Redirect URLs: http://localhost:3000/**  and  https://<your-domain>/**
# 4. SQL Editor: run scripts/001_schema.sql, then 002_rls.sql, then 003_seed.sql
# 5. Storage: create a PUBLIC bucket named `spartanz-media`.
# ============================================================
